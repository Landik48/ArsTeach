# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env не коммитим (он в .gitignore).
#
# APP_ENV и BOT_MODE здесь не задаём — их выставляет docker-compose.yaml по профилю
# (dev: APP_ENV=dev BOT_MODE=polling, prod: APP_ENV=prod BOT_MODE=webhook).

# ---------------------------------------------------------------- MAX ----------
# Токен бота: business.max.ru → Чат-боты → бот → ⋮ → Настройки.
# Для разработки заведите ОТДЕЛЬНОГО тестового бота: polling не работает,
# пока у бота есть подписка на вебхук, а она будет у боевого.
# Без токена в dev всё, кроме самого бота, работает (API, мини-апп в браузере).
MAX_BOT_TOKEN=

# username бота без @. Необязательно: по умолчанию берётся из GET /me
MAX_BOT_USERNAME=

# Секрет вебхука (prod). A-Z a-z 0-9 _ - , от 5 до 256 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAX_WEBHOOK_SECRET=

# Публичный адрес (prod). Вебхук будет на ${PUBLIC_URL}/max/webhook
PUBLIC_URL=https://app.example.ru

# Сколько секунд считать initData свежими (MAX рекомендует час)
INIT_DATA_TTL=3600

# ---------------------------------------------------------------- Caddy (prod) -
# Домен, на который смотрит A-запись сервера. Совпадает с хостом из PUBLIC_URL
DOMAIN=app.example.ru
# Почта для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=admin@example.ru

# ---------------------------------------------------------------- PostgreSQL ---
# Эти же переменные читает контейнер postgres при первой инициализации тома.
# Поменяли пароль после первого запуска — меняйте и в самой базе (ALTER USER).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ---------------------------------------------------------------- Прочее -------
LOG_LEVEL=INFO
